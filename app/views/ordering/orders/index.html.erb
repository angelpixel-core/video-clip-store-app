<% content_for :title, "Orders" %>

<div class="container py-4">
  <div data-role-scope="client" class="vstack gap-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <p class="text-uppercase text-body-secondary mb-1">Client workspace</p>
        <h1 class="h3 mb-0"><%= workspace_for(:client).name %> orders</h1>
      </div>
      <%= link_to "New Order", new_order_path, class: "btn btn-primary" %>
    </div>

    <div>
      <% if @projects.any? %>
        <div class="row g-3">
          <%= render partial: "order", collection: @projects, as: :project %>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h2 class="h5">No orders yet</h2>
            <p class="mb-3 text-body-secondary">Start a new order to create the first order for <%= workspace_for(:client).name %>.</p>
            <%= link_to "Create order", new_order_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div data-role-scope="pm" class="vstack gap-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <p class="text-uppercase text-body-secondary mb-1">PM workspace</p>
        <h1 class="h3 mb-0"><%= workspace_for(:pm).name %> orders</h1>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
          <div>
            <h2 class="h5 mb-0">Assigned orders</h2>
          </div>
          <span class="badge text-bg-dark"><%= @workspace_projects.to_a.size %></span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 workspace-orders-table">
            <colgroup>
              <col class="workspace-orders-col-id">
              <col class="workspace-orders-col-order">
              <col class="workspace-orders-col-created">
              <col class="workspace-orders-col-budget">
              <col class="workspace-orders-col-payment">
              <col class="workspace-orders-col-status">
              <col class="workspace-orders-col-actions">
            </colgroup>
            <thead>
              <tr>
                <th scope="col"><%= table_sort_link("ID", "id", @workspace_sort, @workspace_direction, @workspace_page, path: orders_path) %></th>
                <th scope="col">Order</th>
                <th scope="col"><%= table_sort_link("Created at", "created_at", @workspace_sort, @workspace_direction, @workspace_page, path: orders_path) %></th>
                <th scope="col"><%= table_sort_link("Total budget", "total_budget", @workspace_sort, @workspace_direction, @workspace_page, path: orders_path) %></th>
                <th scope="col">Payment</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody id="workspace-orders-table-body">
              <% if @workspace_projects.any? %>
                <%= render partial: "workspace_order_table_row", collection: @workspace_projects, as: :project %>
              <% else %>
                <tr>
                  <td colspan="7" class="text-body-secondary py-4">No orders yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @workspace_total_pages.to_i > 1 %>
          <nav aria-label="Workspace orders pagination" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap gap-2 mb-0 workspace-orders-pagination">
              <li class="page-item <%= @workspace_page.to_i <= 1 ? 'disabled' : '' %>">
                <% if @workspace_page.to_i <= 1 %>
                  <span class="page-link">Prev</span>
                <% else %>
                  <%= link_to "Prev", orders_path(table_query_params(page: @workspace_page.to_i - 1, sort: @workspace_sort, direction: @workspace_direction)), class: "page-link" %>
                <% end %>
              </li>

              <% pagination_pages = [1, 2, @workspace_page.to_i - 1, @workspace_page.to_i, @workspace_page.to_i + 1, @workspace_total_pages.to_i].select { |page| page.between?(1, @workspace_total_pages.to_i) }.uniq.sort %>
              <% pagination_pages.each_with_index do |page_number, index| %>
                <% previous_page = index.positive? ? pagination_pages[index - 1] : nil %>
                <% if previous_page && page_number > previous_page + 1 %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% end %>

                <li class="page-item <%= 'active' if page_number == @workspace_page.to_i %>">
                  <%= link_to page_number, orders_path(table_query_params(page: page_number, sort: @workspace_sort, direction: @workspace_direction)), class: "page-link" %>
                </li>
              <% end %>

              <li class="page-item <%= @workspace_page.to_i >= @workspace_total_pages.to_i ? 'disabled' : '' %>">
                <% if @workspace_page.to_i >= @workspace_total_pages.to_i %>
                  <span class="page-link">Next</span>
                <% else %>
                  <%= link_to "Next", orders_path(table_query_params(page: @workspace_page.to_i + 1, sort: @workspace_sort, direction: @workspace_direction)), class: "page-link" %>
                <% end %>
              </li>
            </ul>
          </nav>
        <% end %>

      </div>
    </div>
  </div>
</div>
