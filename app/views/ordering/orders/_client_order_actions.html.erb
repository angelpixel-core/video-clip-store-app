<div class="d-flex flex-wrap gap-2">
  <% if project.can_reopen_order? %>
    <%= button_to "Retomar orden", reopen_order_path(project), method: :patch, class: "btn btn-outline-primary" %>
  <% elsif project.can_cancel_order? %>
    <%= button_to "Cancelar orden", cancel_order_path(project), method: :patch, class: "btn btn-outline-danger" %>
  <% end %>

  <% if client_refund_request_enabled? && project.can_request_refund? %>
    <%= button_to "Solicitar reembolso", request_refund_order_path(project), method: :patch, class: "btn btn-outline-warning" %>
  <% end %>
</div>
