<div data-controller="comment-form" class="border rounded-3 p-3">
  <%= form_with url: order_comments_path(project), scope: :comment, local: true, data: { action: "submit->comment-form#submit" } do |form| %>
    <% if comment.errors.any? %>
      <div class="alert alert-danger">
        <strong>Please fix the following:</strong>
        <ul class="mb-0">
          <% comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= hidden_field_tag "comment[author_role]", "client", data: { comment_form_target: "authorRole" } %>

    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
      <div>
        <p class="text-uppercase text-body-secondary small mb-1">New comment</p>
        <h3 class="h6 mb-0">Posting as <span data-comment-form-target="roleLabel">Client</span></h3>
      </div>
      <span class="badge text-bg-light text-uppercase">Shared thread</span>
    </div>

    <div class="mb-3">
      <%= form.label :body, "Message", class: "form-label" %>
      <%= form.text_area :body, rows: 4, class: "form-control", placeholder: "Write a comment..." %>
    </div>

    <%= form.submit "Post comment", class: "btn btn-primary" %>
  <% end %>
</div>
