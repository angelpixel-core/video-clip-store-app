<div class="border rounded-3 bg-white p-3" data-order-form-offer-variant-card>
  <div class="d-flex justify-content-between gap-3">
    <div>
      <h4 class="h6 mb-1"><%= offer_variant.name %></h4>
      <p class="small text-body-secondary mb-0"><%= offer_variant.description %></p>
    </div>
    <span class="fw-semibold"><%= money_to_currency(offer_variant.price_cents) %></span>
  </div>

  <div class="d-flex gap-2 align-items-center mt-3">
    <label class="form-label mb-0" for="offer-variant-<%= offer_variant.id %>-quantity">Qty</label>
    <input id="offer-variant-<%= offer_variant.id %>-quantity" type="number" min="1" value="1" class="form-control form-control-sm" style="max-width: 5rem;" data-order-form-quantity-input>
    <button type="button" class="btn btn-sm btn-primary ms-auto" data-action="click->order-form#addSelection" data-offer-variant-id="<%= offer_variant.id %>" data-offer-variant-name="<%= offer_variant.name %>" data-price-cents="<%= offer_variant.price_cents %>">Add</button>
  </div>
</div>
