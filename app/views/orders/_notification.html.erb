<% role = local_assigns.fetch(:role, :pm).to_s %>
<% prefix = role == "pm" ? "pm" : "client" %>
<% counterpart_label = role == "pm" ? "Client" : "PM" %>
<% read_url = notification_path(notification) %>

<div class="card border-0 shadow-sm <%= prefix %>-notification-item <%= prefix %>-notification-toast" data-controller="notification-action" data-role-scope="<%= role %>" data-notification-item>
  <div class="card-body p-3">
    <div class="d-flex justify-content-between gap-3 mb-2">
      <%= link_to order_path(notification.project), class: "#{prefix}-notification-card-link flex-grow-1 text-reset text-decoration-none d-block", data: { action: "click->notification-action#open", notification_read_url: read_url } do %>
        <p class="text-uppercase text-body-secondary small mb-1">Order update</p>
        <h3 class="h6 mb-1 <%= prefix %>-notification-project-name"><%= notification.project.name %></h3>
        <p class="mb-1"><%= notification.body %></p>
        <p class="mb-0 text-body-secondary small"><%= counterpart_label %>: <%= role == "pm" ? notification.project.owner.name : notification.project.participant.name %></p>
      <% end %>
      <%= form_with url: read_url, method: :patch, local: true, data: { controller: "notification-action", action: "submit->notification-action#submit" } do |form| %>
        <%= form.button class: "#{prefix}-notification-check btn btn-sm btn-outline-dark", aria: { label: "Mark as read" } do %>
          <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-4-4a.5.5 1 0 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0Z"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
