<!DOCTYPE html>
  <html data-workspace-role="<%= workspace_role %>">
  <head>
    <title><%= content_for(:title) || "Video Clip Store App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Video Clip Store App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= vite_client_tag %>

    <script>
      try {
        const storedMode = window.sessionStorage.getItem("workspace-role")
        if (storedMode === "client" || storedMode === "pm") {
          document.documentElement.dataset.workspaceRole = storedMode
        }
      } catch (error) {
        // Session storage can be blocked; fall back to the default client mode.
      }
    </script>

    <%= vite_javascript_tag "application" %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body data-controller="workspace-switch" data-workspace-role="<%= workspace_role %>">
    <header class="app-navbar border-bottom sticky-top shadow-sm">
      <div class="container py-3 d-flex flex-column flex-lg-row align-items-lg-center gap-3">
        <div class="app-navbar-brand pe-lg-4 border-end">
          <%= link_to orders_path, class: "text-decoration-none d-block" do %>
            <p class="app-navbar-eyebrow text-uppercase small mb-1">Workspace demo</p>
            <h1 class="h5 mb-0">Video Clip Store App</h1>
          <% end %>
        </div>

        <div class="ms-lg-auto d-flex align-items-center gap-2">
          <div id="client-notifications-dropdown" class="dropdown client-notifications-dropdown" data-role-scope="client">
            <button
              class="btn btn-outline-light position-relative client-notifications-trigger"
              type="button"
              data-bs-toggle="dropdown"
              data-bs-auto-close="outside"
              aria-expanded="false"
              aria-label="Unread client notifications"
            >
              <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" role="img">
                <path d="M8 16a1.5 1.5 0 0 0 1.415-1H6.585A1.5 1.5 0 0 0 8 16ZM8 1a4 4 0 0 0-4 4v1.09c0 .69-.19 1.36-.55 1.94L2.2 9.9A1.5 1.5 0 0 0 3.5 12h9a1.5 1.5 0 0 0 1.3-2.1l-1.25-1.87A3.9 3.9 0 0 1 12 6.09V5a4 4 0 0 0-4-4Zm0 1a3 3 0 0 1 3 3v1.09c0 .88.25 1.75.72 2.5L12.97 11H3.03l1.25-1.91c.47-.75.72-1.62.72-2.5V5a3 3 0 0 1 3-3Z"/>
              </svg>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-dark client-notifications-badge"><%= workspace_notifications_for(:client).size %></span>
            </button>

            <div class="dropdown-menu dropdown-menu-end p-0 shadow client-notifications-menu">
              <div class="px-3 py-2 border-bottom bg-body-tertiary">
                <p class="text-uppercase text-body-secondary small mb-1">Inbox</p>
                <h2 class="h6 mb-0">Unread notifications</h2>
              </div>

              <div id="client-notifications-menu-list" class="client-notifications-menu-list">
                <% if workspace_notifications_for(:client).any? %>
                  <%= render partial: "notification_row", collection: workspace_notifications_for(:client), as: :notification, locals: { role: :client } %>
                <% else %>
                  <div class="px-3 py-3 text-body-secondary">No unread client notifications.</div>
                <% end %>
              </div>
            </div>
          </div>

          <div id="pm-notifications-dropdown" class="dropdown pm-notifications-dropdown" data-role-scope="pm">
            <button
              class="btn btn-outline-light position-relative pm-notifications-trigger"
              type="button"
              data-bs-toggle="dropdown"
              data-bs-auto-close="outside"
              aria-expanded="false"
              aria-label="Unread PM notifications"
            >
              <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" role="img">
                <path d="M8 16a1.5 1.5 0 0 0 1.415-1H6.585A1.5 1.5 0 0 0 8 16ZM8 1a4 4 0 0 0-4 4v1.09c0 .69-.19 1.36-.55 1.94L2.2 9.9A1.5 1.5 0 0 0 3.5 12h9a1.5 1.5 0 0 0 1.3-2.1l-1.25-1.87A3.9 3.9 0 0 1 12 6.09V5a4 4 0 0 0-4-4Zm0 1a3 3 0 0 1 3 3v1.09c0 .88.25 1.75.72 2.5L12.97 11H3.03l1.25-1.91c.47-.75.72-1.62.72-2.5V5a3 3 0 0 1 3-3Z"/>
              </svg>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-dark pm-notifications-badge"><%= workspace_notifications_for(:pm).size %></span>
            </button>

            <div class="dropdown-menu dropdown-menu-end p-0 shadow pm-notifications-menu">
              <div class="px-3 py-2 border-bottom bg-body-tertiary">
                <p class="text-uppercase text-body-secondary small mb-1">Inbox</p>
                <h2 class="h6 mb-0">Unread notifications</h2>
              </div>

              <div id="pm-notifications-menu-list" class="pm-notifications-menu-list">
                <% if workspace_notifications_for(:pm).any? %>
                  <%= render partial: "notification_row", collection: workspace_notifications_for(:pm), as: :notification, locals: { role: :pm } %>
                <% else %>
                  <div class="px-3 py-3 text-body-secondary">No unread PM notifications.</div>
                <% end %>
              </div>
            </div>

          </div>

          <div class="dropdown account-dropdown">
            <button
              class="btn btn-outline-light account-menu-trigger"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Account menu"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" role="img" class="account-avatar-icon">
                <path d="M12 12.75a4.75 4.75 0 1 0 0-9.5 4.75 4.75 0 0 0 0 9.5Zm0 2.25c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"/>
              </svg>
            </button>

            <div class="dropdown-menu dropdown-menu-end shadow account-menu">
              <div class="px-3 py-2 border-bottom bg-body-tertiary">
                <p class="text-uppercase text-body-secondary small mb-1">Account</p>
                <h2 class="h6 mb-0" data-workspace-switch-target="modeLabel"><%= workspace_role == :pm ? "PM workspace" : "Client workspace" %></h2>
              </div>

              <button class="dropdown-item" type="button" data-workspace-switch-target="switchAction" data-mode="<%= workspace_role == :pm ? "client" : "pm" %>" data-action="click->workspace-switch#select"><%= workspace_role == :pm ? "Switch to Client" : "Switch to PM" %></button>
              <div class="dropdown-divider"></div>
              <%= link_to "Profile", profile_path, class: "dropdown-item" %>
              <span class="dropdown-item-text text-body-secondary">Settings</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <% if flash.any? %>
      <div class="flash-snackbar position-fixed bottom-0 start-50 translate-middle-x p-3" aria-live="polite" aria-atomic="true">
        <div class="vstack gap-2 align-items-center">
          <% flash.each do |type, message| %>
            <% alert_type = type.to_s == "notice" ? "success" : "danger" %>
            <div class="alert alert-<%= alert_type %> alert-dismissible fade show flash-snackbar-item shadow-sm mb-0 text-center" role="alert">
              <span class="d-block w-100 pe-4"><%= message %></span>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div id="client-notifications-panel" data-role-scope="client" class="client-notifications-toast-host position-fixed bottom-0 end-0 p-3 d-flex flex-column gap-3 align-items-end">
      <% if workspace_notifications_for(:client).any? %>
        <div class="visually-hidden" aria-live="polite">
          <%= workspace_notifications_for(:client).size %> unread client notifications
        </div>

        <div class="client-notifications-stack d-flex flex-column gap-3 align-items-end w-100">
          <div class="d-none d-lg-flex align-self-end badge text-bg-dark px-3 py-2 shadow-sm">
            <%= workspace_notifications_for(:client).size %>
          </div>

          <div class="vstack gap-3 w-100 align-items-end">
            <%= render partial: "notification", collection: workspace_notifications_for(:client), as: :notification, locals: { role: :client } %>
          </div>
        </div>
      <% end %>
    </div>

    <div id="pm-notifications-panel" data-role-scope="pm" class="pm-notifications-toast-host position-fixed bottom-0 end-0 p-3 d-flex flex-column gap-3 align-items-end">
      <% if workspace_notifications_for(:pm).any? %>
        <div class="visually-hidden" aria-live="polite">
          <%= workspace_notifications_for(:pm).size %> unread PM notifications
        </div>

        <div class="pm-notifications-stack d-flex flex-column gap-3 align-items-end w-100">
          <div class="d-none d-lg-flex align-self-end badge text-bg-dark px-3 py-2 shadow-sm">
            <%= workspace_notifications_for(:pm).size %>
          </div>

          <div class="vstack gap-3 w-100 align-items-end">
            <%= render partial: "notification", collection: workspace_notifications_for(:pm), as: :notification, locals: { role: :pm } %>
          </div>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
