<h1>Your invoice is ready</h1>

<p><strong>Project:</strong> <%= @project.name %></p>
<p><strong>Invoice:</strong> <%= @payment.invoice_number %></p>
<p><strong>Amount:</strong> <%= @payment.currency %> <%= format("%.2f", @payment.amount_cents.to_f / 100) %></p>

<% if @payment.invoice_document.attached? %>
  <p><a href="<%= rails_blob_url(@payment.invoice_document, disposition: "attachment") %>">Download invoice</a></p>
<% end %>
